# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the Saturday reminder job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in emails)
NEXT_PUBLIC_SITE_URL=https://bensonyc-media.vercel.app

# Resend (https://resend.com) for Saturday reminder emails
RESEND_API_KEY=re_xxx
RESEND_FROM="Benson YC Media <media@yourdomain.com>"

# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me

# ── Social posting (optional) ── see "Social posting" in the README
# Meta developer app → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: pin a Graph API version, e.g. v23.0 (blank = Meta's default)
IG_GRAPH_VERSION=
# TikTok developer app (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# "inbox" sends to TikTok drafts (works before TikTok's audit). "direct" posts straight away (after audit).
TIKTOK_POST_MODE=inbox
# Direct mode only: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# ── Media storage: Cloudflare R2 (recommended) ── see "Media storage" in the README
# Without these, uploads fall back to the Supabase "social" bucket (50 MB per file, 1 GB total on the free plan).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bensonyc-media
# The bucket's public URL: a custom domain (best) or the r2.dev URL
R2_PUBLIC_URL=https://media.yourdomain.com

# Optional: serve the church page (/church) as the homepage of its own domain
CHURCH_HOST=
